# -------------------- Config --------------------
class CFG:
    train_path = "/users/gy22186/mu3e/new_two_signal_files/train_data.parquet"
    test_path  = "/users/gy22186/mu3e/new_two_signal_files/test_data.parquet"
    batch_size = 512
    test_batch_size = 1024
    k_neighbours = 50
    d2_max = 1.5
    top_hard_neg_per_anchor = 8
    add_random_neg = True
    margin = 1.0
