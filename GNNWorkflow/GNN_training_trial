import awkward as ak
import numpy as np
import os
import tensorflow as tf
from tensorflow import keras
from sklearn.utils import shuffle
import pyarrow.parquet as pq
import networkx as nx
from scipy.spatial import cKDTree
from tqdm import tqdm
import logging

# --- Suppress TensorFlow & System Logging ---
os.environ['TF_CPP_MIN_LOG_LEVEL'] = '3'
logging.getLogger("tensorflow").setLevel(logging.ERROR)

# --- Configuration ---
FILE_PATH = '/users/gy22186/mu3e/two_signal_files/train_data.parquet'
K_NEIGHBOURS = 5
GRAPH_BATCH_SIZE = 50 # How many graphs to process in one training step
NUM_EPOCHS = 50
MODEL_SAVE_PATH = "trained_gnn_manual_grouping.keras"

def load_data(file_path):
    """Loads Parquet file and converts it to a flattened Awkward Array."""
    print(f"Loading data from {file_path}...")
    table = pq.read_table(file_path)
    # The error was happening after this step, but ak.from_arrow is fundamental
    # and should work if pyarrow is minimally functional.
    awk_array = ak.from_arrow(table)
    
    flat_dict = {key: ak.to_numpy(awk_array[key]).flatten() for key in awk_array.fields}
    awk_array = ak.Array(flat_dict)
    
    print(f"Loaded dataset: {len(awk_array['hit_ID'])} total hits")
    return awk_array

def build_graph(frame_data, k_neighbours):
    """Constructs a single graph for a given chunk of data (a single frame)."""
    coords = np.column_stack((
        ak.to_numpy(frame_data['gx']),
        ak.to_numpy(frame_data['gy']),
        ak.to_numpy(frame_data['gz']),
    ))
    layers = ak.to_numpy(frame_data['layer_array'])
    
    if len(coords) < 2:
        return None # Not enough nodes to build a graph

    G = nx.Graph()
    for i in range(len(coords)):
        # Store all hit features as node attributes
        node_attrs = {key: frame_data[key][i] for key in frame_data.fields}
        G.add_node(i, **node_attrs)

    layer_indices = {layer: np.where(layers == layer)[0] for layer in np.unique(layers)}
    kdtrees = {layer: cKDTree(coords[indices]) for layer, indices in layer_indices.items()}
    layer_connections = {1: [2], 2: [1, 3], 3: [2, 4], 4: [3]}

    for layer, target_layers in layer_connections.items():
        if layer not in layer_indices: continue
        current_nodes = layer_indices[layer]
        
        for target_layer in target_layers:
            if target_layer not in layer_indices: continue
            target_nodes = layer_indices[target_layer]
            
            k = min(k_neighbours, len(target_nodes))
            if k == 0: continue
            
            _, indices = kdtrees[target_layer].query(coords[current_nodes], k=k)
            if k == 1: indices = np.atleast_2d(indices).T

            for i, source_node_idx in enumerate(current_nodes):
                for neighbour_local_idx in indices[i]:
                    target_node_idx = target_nodes[neighbour_local_idx]
                    G.add_edge(source_node_idx, target_node_idx)
    
    # Only return graphs that have edges
    return G if G.number_of_edges() > 0 else None

def extract_edge_features(G):
    """Extracts features and labels for all edges in a graph."""
    edge_features, edge_labels = [], []

    for u, v in G.edges():
        source, target = G.nodes[u], G.nodes[v]
        source_feats = np.array([source['gx'], source['gy'], source['gz']])
        target_feats = np.array([target['gx'], target['gy'], target['gz']])
        feature_diff = source_feats - target_feats
        categorical_feats = np.array([
            source['layer_array'], source['station_array'], source['ladder_array'], source['chip_array'],
            target['layer_array'], target['station_array'], target['ladder_array'], target['chip_array']
        ])
        edge_feat = np.concatenate([source_feats, target_feats, feature_diff, categorical_feats])
        label = 1 if source['tid_array'] == target['tid_array'] else 0
        edge_features.append(edge_feat)
        edge_labels.append(label)

    return np.array(edge_features), np.array(edge_labels).reshape(-1, 1)

def edge_classifier(input_shape, channels=(32, 64), activation='relu'):
    """MLP-based edge classifier model."""
    inputs = keras.Input(shape=input_shape)
    x = inputs
    for idx, channel in enumerate(channels):
        x = keras.layers.Dense(channel, activation=activation, kernel_initializer='he_normal')(x)
        x = keras.layers.BatchNormalization()(x)
    edge_logits = keras.layers.Dense(1, activation='sigmoid')(x)
    return keras.Model(inputs, edge_logits)

# --- Main Execution ---

# 1. Load data
awk_data = load_data(FILE_PATH)

# 2. Manually build a graph for each frame
print("Building one graph for each frame...")
frame_graphs = []
# Convert frame numbers to a NumPy array for fast processing
all_frame_ids = ak.to_numpy(awk_data.frame_array)
unique_frames = np.unique(all_frame_ids)

for frame_id in tqdm(unique_frames, desc="Processing Frames"):
    # Find all indices corresponding to the current frame_id
    indices = np.where(all_frame_ids == frame_id)[0]
    
    # Slice the main awkward array to get data for only this frame
    frame_data = awk_data[indices]
    
    # Build a graph for this frame
    graph = build_graph(frame_data, K_NEIGHBOURS)
    
    if graph is not None:
        frame_graphs.append(graph)

print(f"Successfully built {len(frame_graphs)} graphs with edges.")

# 3. Initialize the Model
print("Initializing model...")
temp_feats, _ = extract_edge_features(frame_graphs[0])
model = edge_classifier(input_shape=(temp_feats.shape[1],))
model.compile(optimizer='adam', loss='binary_crossentropy', metrics=['accuracy'])
model.summary()

# 4. Train the Model on batches of graphs
for epoch in range(NUM_EPOCHS):
    print(f"\n--- Epoch {epoch+1}/{NUM_EPOCHS} ---")
    
    # Shuffle the list of graphs each epoch
    np.random.shuffle(frame_graphs)
    
    epoch_losses, epoch_accuracies = [], []
    
    # Iterate over the graphs in batches of GRAPH_BATCH_SIZE
    for i in tqdm(range(0, len(frame_graphs), GRAPH_BATCH_SIZE), desc=f"Epoch {epoch+1}"):
        graph_batch = frame_graphs[i : i + GRAPH_BATCH_SIZE]
        
        batch_edge_features, batch_edge_labels = [], []
        
        # Extract features from all graphs in this mini-batch
        for graph in graph_batch:
            features, labels = extract_edge_features(graph)
            if features.shape[0] > 0:
                batch_edge_features.append(features)
                batch_edge_labels.append(labels)
        
        if not batch_edge_features:
            continue

        # Concatenate into single arrays for training
        final_features = np.concatenate(batch_edge_features, axis=0)
        final_labels = np.concatenate(batch_edge_labels, axis=0)
        
        # Train on the aggregated edges from the batch of graphs
        loss, acc = model.train_on_batch(final_features, final_labels)
        epoch_losses.append(loss)
        epoch_accuracies.append(acc)

    avg_loss = np.mean(epoch_losses)
    avg_acc = np.mean(epoch_accuracies)
    print(f"Epoch End - Avg Loss: {avg_loss:.4f}, Avg Acc: {avg_acc:.4f}")

print("\nTraining complete!")
model.save(MODEL_SAVE_PATH)
print(f"Model saved to {MODEL_SAVE_PATH}")