def construct_tracks(all_graphs, all_predictions, all_truth_info, min_track_size=4, score_threshold=0.9):
    all_reconstructed_tracks = []

    ### MODIFICATION ###
    # Renamed variables for clarity (e.g., batch_idx -> frame_idx)
    # The core logic here was mostly fine, as it processes one graph at a time.
    
    for frame_idx, pred_data in enumerate(all_predictions):
        edges, scores = pred_data["edges"], pred_data["scores"]
        G = all_graphs[frame_idx]
        truth_info = all_truth_info[frame_idx]
        
        frame_tracks = []
        scored_edges = sorted(zip(edges, scores), key=lambda x: x[1], reverse=True)
        
        # Keep track of nodes that have already been assigned to a track
        used_nodes = set()

        for (u, v), score in scored_edges:
            if score < score_threshold:
                break # Since edges are sorted, we can stop early

            # If both nodes are already in tracks, skip this edge
            if u in used_nodes and v in used_nodes:
                continue

            # Find existing tracks that contain u or v, but not both
            track_for_u = -1
            track_for_v = -1
            for i, track in enumerate(frame_tracks):
                if u in track["nodes"]:
                    track_for_u = i
                if v in track["nodes"]:
                    track_for_v = i
            
            # Case 1: Merge two existing tracks
            if track_for_u != -1 and track_for_v != -1 and track_for_u != track_for_v:
                # Merge track_for_v into track_for_u
                track1 = frame_tracks[track_for_u]
                track2 = frame_tracks[track_for_v]
                track1["nodes"].update(track2["nodes"])
                for key in ["hit_IDs", "tids", "traj_ps", "traj_pts", "traj_lambdas", "traj_phis"]:
                     track1[key].extend(track2[key])
                # Mark the merged track for removal
                frame_tracks[track_for_v] = None
            
            # Case 2: Add an edge to an existing track
            elif track_for_u != -1 and track_for_v == -1: # Add v to u's track
                frame_tracks[track_for_u]["nodes"].add(v)
                used_nodes.add(v)
                for key, val in truth_info[v].items():
                    frame_tracks[track_for_u][key+"s"].append(val)
            
            elif track_for_v != -1 and track_for_u == -1: # Add u to v's track
                frame_tracks[track_for_v]["nodes"].add(u)
                used_nodes.add(u)
                for key, val in truth_info[u].items():
                    frame_tracks[track_for_v][key+"s"].append(val)

            # Case 3: Create a new track
            elif track_for_u == -1 and track_for_v == -1:
                new_track = {
                    "nodes": {u, v},
                    "hit_IDs": [truth_info[u]["hit_ID"], truth_info[v]["hit_ID"]],
                    "tids": [truth_info[u]["tid"], truth_info[v]["tid"]],
                    "traj_ps": [truth_info[u]["traj_p"], truth_info[v]["traj_p"]],
                    "traj_pts": [truth_info[u]["traj_pt"], truth_info[v]["traj_pt"]],
                    "traj_lambdas": [truth_info[u]["traj_lambda"], truth_info[v]["traj_lambda"]],
                    "traj_phis": [truth_info[u]["traj_phi"], truth_info[v]["traj_phi"]],
                }
                frame_tracks.append(new_track)
                used_nodes.add(u)
                used_nodes.add(v)
        
        # Clean up merged tracks and filter by size
        final_frame_tracks = [t for t in frame_tracks if t is not None and len(t["nodes"]) >= min_track_size]
        all_reconstructed_tracks.append(final_frame_tracks)
        
        if len(final_frame_tracks) > 0:
            print(f"Frame {frame_idx}: Found {len(final_frame_tracks)} valid tracks.")

    return all_reconstructed_tracks


def save_tracks(reconstructed_tracks, all_truth_info, output_path):
    track_data_list = []
    global_track_id = 0

    ### MODIFICATION ###
    # Changed batch_idx to frame_idx for clarity
    for frame_idx, tracks_in_frame in enumerate(reconstructed_tracks):
        for local_track_idx, track in enumerate(tracks_in_frame):
            
            # To avoid duplicates from the greedy algorithm, convert lists to sets and back
            unique_hit_ids = sorted(list(set(track["hit_IDs"])))
            
            # Create a mapping from hit_ID back to its original truth info
            # This is a bit inefficient but robust
            hit_id_to_truth = {}
            truth_info_for_frame = all_truth_info[frame_idx]
            for node_idx in truth_info_for_frame:
                hit_id_to_truth[truth_info_for_frame[node_idx]['hit_ID']] = truth_info_for_frame[node_idx]

            # Rebuild truth lists based on unique hits
            tids = [hit_id_to_truth[hid]['tid'] for hid in unique_hit_ids]
            traj_ps = [hit_id_to_truth[hid]['traj_p'] for hid in unique_hit_ids]
            traj_pts = [hit_id_to_truth[hid]['traj_pt'] for hid in unique_hit_ids]
            traj_lambdas = [hit_id_to_truth[hid]['traj_lambda'] for hid in unique_hit_ids]
            traj_phis = [hit_id_to_truth[hid]['traj_phi'] for hid in unique_hit_ids]

            track_data_list.append({
                "frame_id": all_frames[frame_idx], # Saving the actual frame ID
                "track_id": global_track_id,
                "hit_IDs": unique_hit_ids,
                "tids": tids,
                "traj_ps": traj_ps,
                "traj_pts": traj_pts,
                "traj_lambdas": traj_lambdas,
                "traj_phis": traj_phis,
                "num_hits": len(unique_hit_ids),
            })
            global_track_id += 1

    if not track_data_list:
        print("No tracks were constructed. Output file will be empty.")
        return

    df = pd.DataFrame(track_data_list)
    df.to_csv(output_path, index=False)
    print(f"Saved {len(df)} tracks to {output_path}")

